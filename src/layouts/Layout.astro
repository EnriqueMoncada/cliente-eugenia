---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Mis 15 Años - Valeri Hernández Ferrer" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Meta -->
    <title>{title}</title>
    <meta name="description" content="Estás cordialmente invitado a festejar los 15 años de Valeri Hernández Ferrer. Sábado 21 de Noviembre 2026." />
    <meta property="og:title" content="Mis 15 Años - Valeri Hernández Ferrer" />
    <meta property="og:description" content="Estás cordialmente invitado a festejar mis 15 años." />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="bg-slate-950 text-slate-800 min-h-screen antialiased selection:bg-sky-200 selection:text-sky-900">
    <slot />
  </body>
</html>
