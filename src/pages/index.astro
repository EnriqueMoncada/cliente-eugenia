<script>
  // Scroll reveal observer animation
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal-on-scroll').forEach(el => {
    observer.observe(el);
  });

  // Dress Code Modal Triggers
  const btnDamas = document.getElementById('btn-dress-damas');
  const btnCaballeros = document.getElementById('btn-dress-caballeros');

  if (btnDamas) {
    btnDamas.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-dress-modal', { detail: { gender: 'damas' } }));
    });
  }

  if (btnCaballeros) {
    btnCaballeros.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-dress-modal', { detail: { gender: 'caballeros' } }));
    });
  }

  // Dynamic WhatsApp RSVP Input & Button validation script (+56 9 5601 6250)
  const rsvpBtn = document.getElementById('btn-rsvp-whatsapp');
  const rsvpBtnText = document.getElementById('rsvp-btn-text');
  const whatsappIcon = document.getElementById('whatsapp-icon');
  const guestNameInput = document.getElementById('guest-name') as HTMLInputElement;
  const helperText = document.getElementById('helper-text');
  const helperContainer = document.getElementById('rsvp-helper-container');

  function updateRSVPButtonState() {
    if (!guestNameInput || !rsvpBtn || !rsvpBtnText || !whatsappIcon) return;
    const val = guestNameInput.value.trim();

    if (val.length > 0) {
      // Input has text -> Active Vibrant WhatsApp Green State
      rsvpBtnText.textContent = "Confirmar Asistencia por WhatsApp";
      rsvpBtn.className = "w-full flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 via-green-600 to-emerald-600 text-white font-bold text-sm shadow-xl shadow-emerald-500/20 hover:shadow-2xl hover:scale-[1.03] transition-all duration-300 cursor-pointer ring-2 ring-emerald-400/50";
      whatsappIcon.classList.remove('opacity-70');
      whatsappIcon.classList.add('opacity-100', 'animate-pulse');
      if (helperText && helperContainer) {
        const firstName = val.split(' ')[0];
        helperText.textContent = `¡Excelente ${firstName}! Toca el botón para enviar por WhatsApp`;
        helperContainer.className = "mt-1.5 flex items-center justify-center gap-1 text-[11px] font-semibold text-emerald-700 transition-all duration-300";
      }
    } else {
      // Input empty -> Elegant prompt state
      rsvpBtnText.textContent = "Identifícate primero para confirmar";
      rsvpBtn.className = "w-full flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl bg-gradient-to-r from-slate-400 via-slate-500 to-sky-600 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer opacity-90";
      whatsappIcon.classList.remove('opacity-100', 'animate-pulse');
      whatsappIcon.classList.add('opacity-70');
      if (helperText && helperContainer) {
        helperText.textContent = "Por favor ingresa tu nombre primero";
        helperContainer.className = "mt-1.5 flex items-center justify-center gap-1 text-[11px] font-semibold text-sky-700 transition-all duration-300";
      }
    }
  }

  if (guestNameInput) {
    guestNameInput.addEventListener('input', updateRSVPButtonState);
    guestNameInput.addEventListener('keyup', updateRSVPButtonState);
  }

  if (rsvpBtn) {
    rsvpBtn.addEventListener('click', (e) => {
      const guestName = guestNameInput ? guestNameInput.value.trim() : '';

      if (!guestName) {
        e.preventDefault();
        // Shake/focus input if empty
        if (guestNameInput) {
          guestNameInput.focus();
          guestNameInput.classList.add('ring-4', 'ring-rose-400', 'border-rose-400');
          if (helperText && helperContainer) {
            helperText.textContent = "⚠️ Por favor escribe tu nombre aquí primero";
            helperContainer.className = "mt-1.5 flex items-center justify-center gap-1 text-[11px] font-bold text-rose-600 transition-all duration-300 animate-bounce";
          }
          setTimeout(() => {
            guestNameInput.classList.remove('ring-4', 'ring-rose-400', 'border-rose-400');
            updateRSVPButtonState();
          }, 2500);
        }
        return;
      }

      const message = `¡Hola Valeri! Mi nombre es ${guestName} y confirmo con mucha alegría mi asistencia a tus 15 Años. ✨`;
      const encodedMsg = encodeURIComponent(message);
      window.open(`https://api.whatsapp.com/send?phone=56956016250&text=${encodedMsg}`, '_blank');
    });
  }

  // Run initial state setup
  updateRSVPButtonState();
</script>
