---
import Layout from '../layouts/Layout.astro';
import BackgroundDecorations from '../components/BackgroundDecorations.astro';
import Envelope from '../components/Envelope.astro';
import Countdown from '../components/Countdown.astro';
import GiftModal from '../components/GiftModal.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import SilverFrame from '../components/SilverFrame.astro';
import DressCodeModal from '../components/DressCodeModal.astro';
---

<Layout title="Mis 15 Años - Valeri Hernández Ferrer">

  <!-- 3D Envelope Landing & Opening Sequence (Humo Azul + Chispas + Lazo con Joya Corazón y Corona) -->
  <Envelope />

  <!-- Persistent Background Ornaments (Corona, Rosas en las 4 esquinas, Mariposas, Quinceañera con vestido azul) -->
  <BackgroundDecorations />

  <!-- Ambient Music Player Floating Widget -->
  <MusicPlayer />

  <!-- Main Content Container (Mobile & Desktop Responsive) -->
  <main class="relative z-20 mx-auto max-w-lg md:max-w-2xl lg:max-w-3xl min-h-screen px-4 py-8 sm:px-6 md:px-8 flex flex-col items-center gap-10 md:gap-14">

    <!-- 1. PORTADA -->
    <section class="reveal-on-scroll w-full pt-6 pb-4 flex flex-col items-center text-center">
      <!-- Crown Top Ornament -->
      <div class="flex flex-col items-center justify-center mb-2">
        <svg class="w-9 h-9 text-sky-300 drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] filter" viewBox="0 0 24 24" fill="currentColor">
          <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
          <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
        </svg>
        <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-sky-300 to-transparent mt-1.5"></div>
      </div>

      <p class="font-serif italic text-slate-100 text-base sm:text-lg tracking-widest uppercase mb-2 font-medium">
        Están cordialmente invitados a festejar :
      </p>

      <!-- Main Title: Mis 15 Años -->
      <div class="relative py-1 my-1 flex items-center justify-center gap-2">
        <span class="font-cursive text-5xl sm:text-6xl text-sky-300 drop-shadow-lg">Mis</span>
        <span class="font-serif font-bold text-6xl sm:text-7xl text-silver-gradient drop-shadow-xl border-x-2 border-slate-300/40 px-3">15</span>
        <span class="font-cursive text-5xl sm:text-6xl text-sky-300 drop-shadow-lg">Años</span>
      </div>

      <div class="my-2">
        <h1 class="font-cursive text-5xl sm:text-6xl md:text-7xl text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.6)] tracking-wide">
          Valeri Hernández Ferrer
        </h1>
      </div>

      <div class="w-40 h-0.5 bg-gradient-to-r from-transparent via-slate-200 to-transparent my-3"></div>

      <!-- SECCIÓN CON IMAGEN fondoCentro.jpeg Y ESPEJO AL CENTRO -->
      <div class="relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl aspect-[9/16] mx-auto mt-4 rounded-3xl overflow-hidden shadow-2xl border-2 border-white/80 bg-contain bg-no-repeat bg-center flex flex-col items-center justify-between p-4 sm:p-6 md:p-8"
           style="background-image: url('/fondoCentro.jpeg');">
        
        <!-- LUXURY SILVER PHOTO FRAME SLOT (EL ESPEJO MÁGICO CON MONOGRAMA V PARA VALERI HERNÁNDEZ FERRER) -->
        <div class="relative z-10 w-48 sm:w-56 md:w-64 lg:w-72 aspect-[3/4] rounded-t-full rounded-b-3xl p-2.5 sm:p-3 bg-gradient-to-tr from-slate-300 via-white to-slate-200 shadow-2xl border-2 border-white/90 group transition-transform duration-500 hover:scale-[1.02] mt-6 sm:mt-10 md:mt-28 mb-auto -translate-y-2 sm:-translate-y-4">
          
          <!-- Outer Glow & Diamond Border Line -->
          <div class="absolute inset-1.5 border-2 border-dashed border-sky-300/80 rounded-t-full rounded-b-2xl pointer-events-none"></div>

          <!-- Top Tiara Crown Jewel Ornament -->
          <div class="absolute -top-5 left-1/2 -translate-x-1/2 z-20 text-slate-100 drop-shadow-[0_0_10px_rgba(255,255,255,0.9)]">
            <svg class="w-10 h-10 text-slate-100 filter drop-shadow" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
              <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
            </svg>
          </div>

          <!-- Magic Mirror Container Slot -->
          <div class="relative w-full h-full rounded-t-full rounded-b-xl overflow-hidden bg-gradient-to-b from-sky-950 via-sky-800 to-slate-900 border border-slate-300/50 shadow-inner flex flex-col items-center justify-between pb-4 px-3">
            
            <!-- Soft Radial Sky Glow Overlay -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-sky-300/40 via-sky-600/20 to-transparent"></div>

            <!-- Sparkling Diamond Aura & Monogram (Con pt-12 sm:pt-16 para ubicar la V en la zona media holgada) -->
            <div class="relative z-10 flex flex-col items-center justify-center text-center w-full pt-12 sm:pt-16 my-auto">
              
              <!-- Tiara Icon above V -->
              <div class="mb-1 text-sky-200 animate-pulse drop-shadow-[0_0_8px_rgba(255,255,255,0.9)]">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
                  <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
                </svg>
              </div>

              <!-- Royal Monogram Letter V (Con pt-6 pb-2 inline-block para dar 24px de margen dentro de la caja del span al lazo superior) -->
              <div class="w-full flex items-center justify-center overflow-visible">
                <span class="font-cursive text-5xl sm:text-6xl text-silver-gradient drop-shadow-[0_0_18px_rgba(255,255,255,0.95)] inline-block pt-6 pb-2 px-4 leading-[1.8] select-none">
                  V
                </span>
              </div>

              <!-- Name & Sparkle Subtitle -->
              <div class="mt-1 flex items-center justify-center gap-1.5 w-full">
                <span class="text-sky-300 text-xs animate-pulse">✨</span>
                <span class="text-white font-cursive text-2xl sm:text-3xl drop-shadow-md">Valeri</span>
                <span class="text-sky-300 text-xs animate-pulse">✨</span>
              </div>
              
              <span class="text-[10px] uppercase tracking-widest font-bold text-sky-200/90 mt-1 font-serif">
                Mis 15 Años
              </span>
            </div>

            <!-- Glossy Glass Reflection Overlay -->
            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/30 to-white/10 pointer-events-none"></div>
          </div>

          <!-- Diamond Corner Accents -->
          <span class="absolute top-4 left-4 text-white text-xs drop-shadow-[0_0_6px_rgba(255,255,255,1)]">✦</span>
          <span class="absolute top-4 right-4 text-white text-xs drop-shadow-[0_0_6px_rgba(255,255,255,1)]">✦</span>
          <span class="absolute bottom-4 left-4 text-white text-xs drop-shadow-[0_0_6px_rgba(255,255,255,1)]">✦</span>
          <span class="absolute bottom-4 right-4 text-white text-xs drop-shadow-[0_0_6px_rgba(255,255,255,1)]">✦</span>

          <!-- Bottom Crown & Ribbon Image (corona.png) -->
          <div class="absolute -bottom-16 sm:-bottom-20 left-1/2 -translate-x-1/2 z-30 w-20 sm:w-24 md:w-28 pointer-events-none filter drop-shadow-lg">
            <img src="/corona.png" alt="Corona de Quinceañera" class="w-full h-auto object-contain filter drop-shadow-[0_4px_8px_rgba(0,0,0,0.4)]" />
          </div>
        </div>

        <!-- ELEGANT BANNER TEXT IN THE CENTER BELOW MIRROR -->
        <div class="relative z-20 mt-2 py-2 px-6 sm:py-3 sm:px-8 md:py-3.5 md:px-10 rounded-full bg-slate-900/80 border border-sky-300/50 backdrop-blur-md shadow-xl flex items-center justify-center gap-2">
          <span class="text-sky-300 text-xs sm:text-sm animate-pulse">✨</span>
          <span class="font-serif italic text-sm sm:text-base md:text-lg lg:text-xl text-sky-100 tracking-widest drop-shadow font-medium">
            Un sueño hecho realidad • Valeri Hernández Ferrer
          </span>
          <span class="text-sky-300 text-xs sm:text-sm animate-pulse">✨</span>
        </div>

      </div>
    </section>

    <!-- 2. MENSAJE -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <span class="text-xs font-bold uppercase tracking-widest text-celeste-700 block mb-3">MIS 15 AÑOS</span>

        <p class="font-serif italic text-base sm:text-lg text-slate-800 leading-relaxed font-normal px-2 sm:px-4">
          "Hace quince años nació una hermosa niña, enviada por Dios para ser criada y formada como el más grande tesoro. Hay momentos en la vida que imaginamos, soñamos y esperamos. Uno de esos momentos ha llegado."
        </p>

        <div class="mt-4 flex items-center justify-center gap-2 text-sky-400 text-xs">
          <span>✦</span>
          <span class="w-8 h-px bg-sky-200"></span>
          <span>✨</span>
          <span class="w-8 h-px bg-sky-200"></span>
          <span>✦</span>
        </div>
      </SilverFrame>
    </section>

    <!-- 3. PADRES -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Con la bendición de sus amados padres</p>
        <h3 class="font-cursive text-5xl font-bold text-slate-800 mb-2">Mis Padres</h3>

        <!-- Heartwarming Parent Dedication Quote -->
        <p class="font-serif italic text-sm sm:text-base text-slate-700 leading-relaxed mb-4 max-w-sm mx-auto font-normal px-2">
          "Gracias a mis padres por brindarme su amor incondicional, ser mi guía y acompañarme a cumplir este hermoso sueño."
        </p>

        <!-- Side-by-Side Royal Parent Badges -->
        <div class="grid grid-cols-2 gap-3 max-w-sm mx-auto my-2">
          <!-- Madre: Karoline -->
          <div class="bg-gradient-to-b from-sky-50/90 via-white to-sky-50/70 p-4 rounded-2xl border border-sky-200 shadow-sm flex flex-col items-center transition-transform hover:scale-[1.03]">
            <div class="w-10 h-10 rounded-full bg-sky-100 text-celeste-700 flex items-center justify-center mb-1.5 shadow-inner border border-sky-200">
              <svg class="w-5 h-5 text-sky-600" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <span class="text-[10px] font-bold text-sky-800 uppercase tracking-widest font-serif">Mi Madre</span>
            <span class="font-cursive text-3xl sm:text-4xl text-slate-800 mt-1 font-bold">Karoline</span>
          </div>

          <!-- Padre: Robert -->
          <div class="bg-gradient-to-b from-sky-50/90 via-white to-sky-50/70 p-4 rounded-2xl border border-sky-200 shadow-sm flex flex-col items-center transition-transform hover:scale-[1.03]">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center mb-1.5 shadow-inner border border-slate-200">
              <svg class="w-5 h-5 text-slate-700" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
              </svg>
            </div>
            <span class="text-[10px] font-bold text-slate-700 uppercase tracking-widest font-serif">Mi Padre</span>
            <span class="font-cursive text-3xl sm:text-4xl text-slate-800 mt-1 font-bold">Robert</span>
          </div>
        </div>

        <div class="mt-3 flex items-center justify-center gap-2 text-sky-400 text-xs">
          <span>✦</span>
          <span class="w-10 h-px bg-sky-200"></span>
          <span>✨</span>
          <span class="w-10 h-px bg-sky-200"></span>
          <span>✦</span>
        </div>
      </SilverFrame>
    </section>

    <!-- 4. FECHA Y CONTEO REGRESIVO -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <p class="text-xs uppercase tracking-widest text-slate-600 font-bold mb-2">
          Estás cordialmente invitado a festejar los 15 años el día:
        </p>
        
        <div class="my-4 py-3.5 border-y-2 border-slate-300/80 flex items-center justify-center gap-2 sm:gap-4 text-slate-900 font-serif font-bold text-lg sm:text-2xl shadow-xs">
          <span class="text-celeste-700 uppercase tracking-widest">NOVIEMBRE</span>
          <span class="text-slate-300">|</span>
          <span class="text-2xl sm:text-3xl text-slate-900 bg-sky-100/90 px-4 py-1.5 rounded-xl shadow-inner border border-sky-200/80">SÁBADO 21</span>
          <span class="text-slate-300">|</span>
          <span class="text-celeste-700">2026</span>
        </div>

        <!-- Live Countdown & Add to Calendar Button -->
        <Countdown />
      </SilverFrame>
    </section>

    <!-- 5. RECEPCIÓN -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <h3 class="font-cursive text-5xl font-bold text-slate-800 mb-2">Recepción</h3>
        
        <!-- Silver Map Pin Icon -->
        <div class="w-14 h-14 rounded-full bg-sky-100 text-slate-700 mx-auto my-3 flex items-center justify-center filter drop-shadow border border-sky-200">
          <svg class="w-8 h-8 fill-current text-sky-600" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>

        <p class="font-sans font-bold text-lg text-slate-800 tracking-wider my-2">
          RESTAURANTE CHINO MI SABOR
        </p>

        <!-- Google Maps Link Button -->
        <a href="https://maps.app.goo.gl/nz9HZpB51VB1TaxB8?g_st=iw" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-slate-900 text-white font-medium text-sm shadow-lg hover:bg-slate-800 hover:scale-105 transition-all duration-300 border border-sky-300/30">
          <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Ver Ubicación en Google Maps</span>
        </a>
      </SilverFrame>
    </section>

    <!-- 6. HORARIO -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl flex flex-col items-center justify-center">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Hora de Inicio</p>
        <h3 class="font-cursive text-5xl font-bold text-slate-800 mb-3">Horario</h3>

        <!-- Ornate Clock Badge & Time Card -->
        <div class="my-2 p-5 sm:p-6 rounded-2xl bg-gradient-to-b from-sky-50/90 via-white to-sky-50/70 border border-sky-200 shadow-md max-w-xs mx-auto flex flex-col items-center">
          
          <!-- Animated Clock SVG Icon -->
          <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-sky-100 to-white text-celeste-700 flex items-center justify-center mb-3 shadow-inner border-2 border-sky-300/80 shadow-[0_0_15px_rgba(125,211,252,0.5)]">
            <svg class="w-9 h-9 text-sky-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 2"/>
            </svg>
          </div>

          <!-- Time Display -->
          <p class="font-serif text-4xl sm:text-5xl font-bold text-celeste-800 tracking-wide drop-shadow-xs">
            8:00 pm
          </p>

          <span class="text-[11px] text-slate-600 font-serif italic mt-2">
            "Inicio puntual de la recepción"
          </span>
        </div>

        <div class="mt-4 flex items-center justify-center gap-2 text-sky-400 text-xs">
          <span>✦</span>
          <span class="w-10 h-px bg-sky-200"></span>
          <span>✨</span>
          <span class="w-10 h-px bg-sky-200"></span>
          <span>✦</span>
        </div>
      </SilverFrame>
    </section>

    <!-- 7. DRESS CODE (VESTIMENTA FORMAL) -->
    <section class="reveal-on-scroll w-full">
      <SilverFrame className="glass-card rounded-3xl text-center shadow-xl">
        <!-- Crown Top Ornament -->
        <div class="flex flex-col items-center justify-center mb-2">
          <svg class="w-8 h-8 text-celeste-600 drop-shadow-sm filter" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            <circle cx="12" cy="3" r="1.5" fill="#ffffff" />
          </svg>
          <div class="w-14 h-0.5 bg-gradient-to-r from-transparent via-celeste-500/50 to-transparent mt-1"></div>
        </div>

        <h3 class="font-cursive text-5xl font-bold text-slate-800 mb-1">Código de Vestimenta</h3>
        <p class="font-sans font-bold text-base tracking-widest text-celeste-700 uppercase mb-3 bg-sky-50 py-1.5 px-4 rounded-full inline-block border border-sky-200">
          VESTIMENTA FORMAL
        </p>

        <!-- Dynamic Click Prompt -->
        <div class="block my-3">
          <div class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-full bg-sky-100 text-celeste-800 text-xs font-semibold border border-sky-200 shadow-xs animate-pulse">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
            </svg>
            <span>Haz clic para ver detalles</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <!-- Damas (Mujer) Button -->
          <button id="btn-dress-damas" class="bg-sky-50/90 hover:bg-sky-100 rounded-2xl p-4 border border-sky-200 flex flex-col items-center justify-center transition-all duration-300 transform hover:scale-[1.03] hover:shadow-md cursor-pointer group">
            <div class="w-12 h-12 text-celeste-600 mb-2 group-hover:scale-110 transition-transform">
              <svg viewBox="0 0 64 64" fill="currentColor" class="w-full h-full drop-shadow-sm">
