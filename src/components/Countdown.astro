<div class="flex flex-col items-center justify-center w-full max-w-sm sm:max-w-md md:max-w-lg mx-auto my-4">
  <!-- Countdown Grid -->
  <div id="countdown-timer" class="grid grid-cols-4 gap-2 text-center w-full my-4">
    <div class="glass-card p-3 rounded-xl flex flex-col items-center justify-center border border-sky-200 shadow-sm">
      <span id="days" class="text-2xl sm:text-3xl font-bold text-celeste-700 font-sans">00</span>
      <span class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-widest font-medium">Días</span>
    </div>

    <div class="glass-card p-3 rounded-xl flex flex-col items-center justify-center border border-sky-200 shadow-sm">
      <span id="hours" class="text-2xl sm:text-3xl font-bold text-celeste-700 font-sans">00</span>
      <span class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-widest font-medium">Horas</span>
    </div>

    <div class="glass-card p-3 rounded-xl flex flex-col items-center justify-center border border-sky-200 shadow-sm">
      <span id="minutes" class="text-2xl sm:text-3xl font-bold text-celeste-700 font-sans">00</span>
      <span class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-widest font-medium">Minutos</span>
    </div>

    <div class="glass-card p-3 rounded-xl flex flex-col items-center justify-center border border-sky-200 shadow-sm">
      <span id="seconds" class="text-2xl sm:text-3xl font-bold text-celeste-700 font-sans">00</span>
      <span class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-widest font-medium">Segundos</span>
    </div>
  </div>

