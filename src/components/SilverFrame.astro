---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`relative p-6 sm:p-8 md:p-9 transition-all duration-300 group/frame ${className}`}>
  <!-- SVG Silver Ornate Frame Border Overlay -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none drop-shadow-lg text-slate-300" viewBox="0 0 400 200" preserveAspectRatio="none" fill="none">
    <!-- Outer Metallic Border -->
    <rect x="6" y="6" width="388" height="188" rx="20" stroke="url(#silverGradFrame)" stroke-width="2.5" opacity="0.95" />
    <rect x="12" y="12" width="376" height="176" rx="15" stroke="url(#silverGradFrame)" stroke-width="1.2" stroke-dasharray="6 3" opacity="0.8" />

    <!-- Inner Filigree Line -->
    <rect x="18" y="18" width="364" height="164" rx="10" stroke="url(#skyGradFrame)" stroke-width="0.8" opacity="0.45" />

    <!-- Corner Ornaments (Top Left) -->
    <path d="M 6 32 C 6 18, 18 6, 32 6 C 26 20, 20 26, 6 32 Z" fill="url(#silverGradFrame)" opacity="0.95" />
    <circle cx="24" cy="24" r="3.5" fill="#ffffff" stroke="#94a3b8" stroke-width="0.5" />
    
    <!-- Corner Ornaments (Top Right) -->
    <path d="M 394 32 C 394 18, 382 6, 368 6 C 374 20, 380 26, 394 32 Z" fill="url(#silverGradFrame)" opacity="0.95" />
    <circle cx="376" cy="24" r="3.5" fill="#ffffff" stroke="#94a3b8" stroke-width="0.5" />

    <!-- Corner Ornaments (Bottom Left) -->
    <path d="M 6 168 C 6 182, 18 194, 32 194 C 26 180, 20 174, 6 168 Z" fill="url(#silverGradFrame)" opacity="0.95" />
    <circle cx="24" cy="176" r="3.5" fill="#ffffff" stroke="#94a3b8" stroke-width="0.5" />

    <!-- Corner Ornaments (Bottom Right) -->
    <path d="M 394 168 C 394 182, 382 194, 368 194 C 374 180, 380 174, 394 168 Z" fill="url(#silverGradFrame)" opacity="0.95" />
    <circle cx="376" cy="176" r="3.5" fill="#ffffff" stroke="#94a3b8" stroke-width="0.5" />

    <!-- Top Center Royal Flourish -->
    <path d="M 175 6 Q 200 -2 225 6 Q 200 14 175 6 Z" fill="url(#silverGradFrame)" />
    <circle cx="200" cy="5" r="2.5" fill="#38bdf8" />

    <!-- Bottom Center Royal Flourish -->
    <path d="M 175 194 Q 200 202 225 194 Q 200 186 175 194 Z" fill="url(#silverGradFrame)" />
    <circle cx="200" cy="195" r="2.5" fill="#38bdf8" />

    <defs>
      <linearGradient id="silverGradFrame" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="25%" stop-color="#cbd5e1" />
        <stop offset="50%" stop-color="#ffffff" />
        <stop offset="75%" stop-color="#94a3b8" />
        <stop offset="100%" stop-color="#f8fafc" />
      </linearGradient>
      <linearGradient id="skyGradFrame" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#38bdf8" />
        <stop offset="50%" stop-color="#7dd3fc" />
        <stop offset="100%" stop-color="#38bdf8" />
      </linearGradient>
    </defs>
  </svg>

  <!-- Diamond Sparkle Accents on Corners -->
  <span class="absolute top-2.5 left-2.5 text-sky-400 text-[10px] drop-shadow-[0_0_6px_rgba(255,255,255,1)] pointer-events-none transition-transform duration-300 group-hover/frame:scale-125">✦</span>
  <span class="absolute top-2.5 right-2.5 text-sky-400 text-[10px] drop-shadow-[0_0_6px_rgba(255,255,255,1)] pointer-events-none transition-transform duration-300 group-hover/frame:scale-125">✦</span>
  <span class="absolute bottom-2.5 left-2.5 text-sky-400 text-[10px] drop-shadow-[0_0_6px_rgba(255,255,255,1)] pointer-events-none transition-transform duration-300 group-hover/frame:scale-125">✦</span>
  <span class="absolute bottom-2.5 right-2.5 text-sky-400 text-[10px] drop-shadow-[0_0_6px_rgba(255,255,255,1)] pointer-events-none transition-transform duration-300 group-hover/frame:scale-125">✦</span>

  <div class="relative z-10">
    <slot />
  </div>
</div>
