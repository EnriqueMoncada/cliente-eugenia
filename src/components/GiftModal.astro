---
---

<div class="w-full flex flex-col items-center">
  <button id="open-gift-modal" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-sky-400 via-sky-500 to-sky-600 text-white font-medium text-sm shadow-md hover:shadow-lg hover:scale-105 transition-all duration-300">
    <svg class="w-5 h-5 text-rose-200 fill-current" viewBox="0 0 24 24">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span>Ver datos bancarios / Regalo</span>
  </button>

  <!-- Modal Overlay (z-[99999] appended to body to guarantee layering above all cards) -->
  <div id="gift-modal" class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-950/80 backdrop-blur-md hidden p-4 opacity-0 transition-opacity duration-300">
    <div class="relative w-full max-w-md glass-card rounded-3xl p-6 sm:p-8 shadow-2xl border-2 border-sky-300/80 text-slate-800 transform scale-95 transition-transform duration-300" id="gift-modal-card">
      
      <!-- Close Button -->
      <button id="close-gift-modal" aria-label="Cerrar modal" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1.5 rounded-full hover:bg-slate-100 transition-colors cursor-pointer z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Modal Header -->
      <div class="text-center mb-6">
        <div class="w-14 h-14 rounded-full bg-gradient-to-tr from-sky-100 via-sky-50 to-sky-200 text-celeste-700 flex items-center justify-center mx-auto mb-3 shadow-md border border-sky-300/60">
          <svg class="w-7 h-7 text-sky-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="font-serif text-2xl font-bold text-slate-800">Regalo en Efectivo</h3>
        <p class="text-xs text-slate-600 mt-2 font-medium px-2 leading-relaxed">
          "Tu presencia es mi mejor regalo. Si deseas hacerme un detalle, el mejor obsequio para mí será en efectivo."
        </p>
      </div>

      <!-- Bank Info & Envelope Note Cards -->
      <div class="space-y-4">
        <!-- Envelope Note (Lluvia de Sobres en la fiesta) -->
        <div class="bg-gradient-to-r from-sky-50 via-white to-sky-50 rounded-2xl p-4 border border-sky-200 shadow-sm text-center">
          <div class="flex items-center justify-center gap-2 mb-1.5">
            <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
            </svg>
            <span class="text-xs font-bold text-celeste-800 uppercase tracking-wider">Lluvia de Sobres</span>
          </div>
          <p class="text-xs text-slate-700 leading-relaxed font-sans">
            El día de la recepción contaremos con un elegante buzón para la entrega de sobres en efectivo.
          </p>
        </div>

        <!-- Transferencia opcional -->
        <div class="bg-slate-50/90 rounded-2xl p-4 border border-slate-200">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="1.8"/>
                <path d="M2 10h20" stroke-width="1.8"/>
              </svg>
              <span>Transferencia Digital</span>
            </span>
            <span class="text-[10px] bg-sky-100 text-sky-800 px-2.5 py-0.5 rounded-full font-bold">Opcional</span>
          </div>
          <div class="text-xs space-y-1.5 text-slate-700 font-sans">
            <p><span class="text-slate-500 font-medium">Titular:</span> Valeri Hernández Ferrer / Karoline</p>
            <p><span class="text-slate-500 font-medium">Concepto:</span> Regalo 15 Años Valeri Hernández Ferrer</p>
            <div class="flex items-center justify-between bg-white p-2.5 rounded-xl border border-slate-200 mt-2 shadow-xs">
              <span class="font-mono text-xs text-slate-800 font-semibold select-all" id="bank-number">Consultar datos al +56 9 5601 6250</span>
              <button class="copy-btn text-xs bg-sky-50 text-celeste-700 px-2.5 py-1 rounded-lg hover:bg-sky-100 transition-colors font-bold flex items-center gap-1 border border-sky-200" data-copy="+56956016250">
                <span>Copiar N°</span>
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('open-gift-modal');
  const closeBtn = document.getElementById('close-gift-modal');
  const modal = document.getElementById('gift-modal');
  const modalCard = document.getElementById('gift-modal-card');

  function showModal() {
    if (!modal || !modalCard) return;
    // Append modal to body to ensure it is never trapped inside card stacking contexts
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
    }, 10);
  }

  function hideModal() {
    if (!modal || !modalCard) return;
    modal.classList.add('opacity-0');
    modalCard.classList.remove('scale-100');
    modalCard.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }

  if (openBtn) openBtn.addEventListener('click', showModal);
  if (closeBtn) closeBtn.addEventListener('click', hideModal);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
  }

  // Copy functionality
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          const span = btn.querySelector('span');
          if (span) {
            const original = span.innerText;
            span.innerText = '¡Copiado! ✓';
            setTimeout(() => {
              span.innerText = original;
            }, 2000);
          }
        });
      }
    });
  });
</script>
